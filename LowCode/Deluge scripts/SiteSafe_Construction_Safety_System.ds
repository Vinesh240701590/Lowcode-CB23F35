 application "SiteSafe Construction Safety System"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "America/Los_Angeles"
 	time format = "24-hr"

 	forms
	{
		form ai_insights_log
		{
			displayname = "AI Insights Log"
			success message = "Data Added Successfully!"
