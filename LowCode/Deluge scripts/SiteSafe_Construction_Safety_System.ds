	 			row = 1
	 			column = 1   
				width = medium
			)
			project_start_date
			(
    			type = date
				displayname = "Project Start Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			expected_completion_date
			(
    			type = date
				displayname = "Expected Completion Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			site_status
			(
				type = picklist
				displayname = "Site Status"
				values = {"Active","On Hold","Closed","Completed"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			overall_safety_status
			(
				type = picklist
				displayname = "Overall Safety Status"
				values = {"Warning","Safe","Critical"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			open_hazard_count
			(
				type = number
				displayname = "Open Hazard Count"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			site_code
			(
    			type = text
				displayname = "Site Code"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form work_permit_management
		{
			displayname = "Work Permit Management"
			success message = "Work Permit Management Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			work_type
			(
				type = picklist
				displayname = "Work Type"
				values = {"Hot Work","Confined Space Entry","Electrical Isolation","Working at Heights","Excavation","Lifting Operations"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			work_location
			(
    			type = text
				displayname = "Work Location"
	 			row = 1
	 			column = 1   
				width = medium
			)
			requested_by
			(
    			type = name
				displayname = "Requested By"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			work_start_datetime
			(
    			type = datetime
				displayname = "Work Start Date and Time"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			work_end_datetime
			(
    			type = datetime
				displayname = "Work End Date and Time"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			hazard_assessment_completed
			(
    			type = checkbox
				displayname = "Hazard Assessment Completed"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			required_precautions_verified
			(
    			type = checkbox
				displayname = "Required Precautions Verified"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			required_documents_verified
			(
    			type = checkbox
				displayname = "Required Documents Verified"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			permit_status
			(
				type = picklist
				displayname = "Permit Status"
				values = {"Submitted","Draft","Active","Closed","Approved","Expired","Rejected"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			approved_by
			(
    			type = name
				displayname = "Approved By"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			approval_date
			(
    			type = date
				displayname = "Approval Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			expiry_status
			(
				type = picklist
				displayname = "Expiry Status"
				values = {"Valid","Expired","Not Applicable"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			closure_notes
			(
    			type = textarea
				displayname = "Closure Notes"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			site_reference
			(
				type = list	
				displayname = "Site Reference"
				values  = site_registry.ID
    			displayformat = [site_name]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			permit_id
			(
    			type = text
				displayname = "Permit ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Permit Requested","Pending Document Verification","Permit Cancelled","Pending Safety Assessment","Pending Approval","Permit Active","Work In Progress","Permit Suspended","Work Completed","Pending Closure","Permit Closed"}
			}
		}
	}
	reports
	{
		list hazard_register_Report
		{
			displayName = "All Hazard Registers"
			show all rows from hazard_register    
			(
				hazard_description as "Hazard Description"
				hazard_category as "Hazard Category"
				potential_consequence as "Potential Consequence"
				ai_risk_level as "AI Risk Level"
				ai_risk_explanation as "AI Risk Explanation"
				recommended_preventive_action as "Recommended Preventive Action"
				assigned_person  as "Assigned Person"
				priority as "Priority"
				date_reported as "Date Reported"
				due_date as "Due Date"
				status as "Status"
				resolution_evidence as "Resolution Evidence"
				verified_by  as "Verified By"
				closure_date as "Closure Date"
				site_reference as "Site Reference"
				inspection_reference as "Inspection Reference"
				hazard_id as "Hazard ID"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (hazard_category == "Biological")
				fields = [hazard_category]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (hazard_category == "Chemical")
				fields = [hazard_category]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (hazard_category == "Physical")
				fields = [hazard_category]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
				"New Formatting4"
				{
				condition = (hazard_category == "Psychosocial")
				fields = [hazard_category]
				format = "color:#ffffff;background-color:#3598db;"
				}
			)
		}
		kanban hazard_register_by_hazard_category
		{
