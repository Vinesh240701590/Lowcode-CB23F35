	chats
	{
		chat Site_Safety_Assistant
		{
			display name = "Site Safety Assistant"
			access level = read_write
			instructions
			(
				value = "You are a Site Safety Assistant designed to help administrators and users manage safety operations within the application. Your primary role is to assist with data operations across the hazard register, safety inspections, corrective action tracker, and site registry modules.\nRetrieve, analyze, and summarize data from the selected modules to provide insights on site safety status.\nAssist users in creating, updating, or closing records related to hazards, inspections, and corrective actions when requested.\nProvide clear, concise summaries of safety trends, pending tasks, and compliance status.\nDo not attempt to configure the application, modify forms, workflows, or system settings. Focus strictly on data interaction.\nIf a user asks for administrative setup tasks, politely decline and redirect them to data-related assistance.\nEnsure all data interactions respect the context of the current user's session and available modules."
			)
			personalization
			(
				welcome message = "Hello! I am your Site Safety Assistant. I can help you track hazards, manage inspections, monitor corrective actions, and review site registry data to ensure overall site safety."
			)
			forms
			(
				safety_inspections
				corrective_action_tracker
				hazard_register
				site_registry
			)
		}
	}




		workflow
		{
		form
		{
			auto_set_site_safety_status as "Auto-Set Site Safety Status"
			{
				type =  form
				form = site_registry

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Fetch the current site record from site_registry form
										siteRecord = site_registry[ID == input.ID];
										// Get the open hazard count from the input
										openHazardCount = input.open_hazard_count;
										// Determine the overall safety status based on open hazard count
										if(openHazardCount == 0)
										{
											// No open hazards - site is safe
											siteRecord.overall_safety_status="Safe";
										}
										else if(openHazardCount > 0 && openHazardCount <= 3)
										{
											// Few open hazards - site has warning status
											siteRecord.overall_safety_status="Warning";
										}
										else if(openHazardCount > 3)
										{
											// Many open hazards - site is critical
											siteRecord.overall_safety_status="Critical";
										}
										// Update the site record with the new safety status
										update siteRecord
										[
											overall_safety_status=siteRecord.overall_safety_status
										];
										// Log the update action
										info "Updated overall safety status for site: " + siteRecord.site_name + " to " + siteRecord.overall_safety_status;
						)
					}
				}

			}
		}






	}
