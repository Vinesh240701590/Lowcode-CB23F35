	 			column = 1   
				width = medium
			)
			generated_date
			(
    			type = date
				displayname = "Generated Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			reviewed_by
			(
    			type = name
				displayname = "Reviewed By"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			review_status
			(
				type = picklist
				displayname = "Review Status"
				values = {"Approved","Rejected","Pending","Reviewed"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			related_site
			(
				type = list	
				displayname = "Related Site"
				values  = site_registry.ID
    			displayformat = [site_name]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			related_hazard
			(
				type = list	
				displayname = "Related Hazard"
				values  = hazard_register.ID
    			displayformat = [hazard_id]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			insight_id
			(
    			type = text
				displayname = "Insight ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
